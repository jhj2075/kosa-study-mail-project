<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="futurenet.fullstack.auth.mapper.UserMapper">

    <resultMap id="userResultMap" type="futurenet.fullstack.auth.entity.User">
        <id property="userId" column="USER_ID" />
        <result property="loginId" column="LOGIN_ID" />
        <result property="password" column="PASSWORD" />
        <result property="userName" column="USER_NAME" />
        <result property="email" column="EMAIL" />
        <result property="status" column="STATUS" />
        <result property="createdAt" column="CREATED_AT" />
        <result property="updatedAt" column="UPDATED_AT" />
    </resultMap>

    <sql id="userColumns">
        USER_ID,
        LOGIN_ID,
        PASSWORD,
        USER_NAME,
        EMAIL,
        STATUS,
        CREATED_AT,
        UPDATED_AT
    </sql>

    <select id="findByLoginId" parameterType="string" resultMap="userResultMap">
        SELECT
        <include refid="userColumns" />
        FROM USERS
        WHERE LOGIN_ID = #{loginId}
    </select>

    <select id="findByEmail" parameterType="string" resultMap="userResultMap">
        SELECT
        <include refid="userColumns" />
        FROM USERS
        WHERE EMAIL = #{email}
    </select>

    <insert id="insertUser"
            parameterType="futurenet.fullstack.auth.entity.User"
            useGeneratedKeys="true"
            keyProperty="userId"
            keyColumn="USER_ID">
        INSERT INTO USERS (
            LOGIN_ID,
            PASSWORD,
            USER_NAME,
            EMAIL,
            STATUS
        ) VALUES (
            #{loginId},
            #{password},
            #{userName},
            #{email},
            #{status}
        )
    </insert>

</mapper>
