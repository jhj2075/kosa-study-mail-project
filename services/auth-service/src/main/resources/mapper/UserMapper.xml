<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="futurenet.fullstack.auth.mapper.UserMapper">

    <select id="findByEmail"
            parameterType="string"
            resultType="futurenet.fullstack.auth.entity.User">

        SELECT
            USER_ID,
            EMAIL,
            PASSWORD,
            NAME,
            ROLE
        FROM USERS
        WHERE EMAIL = #{email}

    </select>
    
    <insert id="insertUser"
        parameterType="futurenet.fullstack.auth.entity.User">

    INSERT INTO USERS (
        EMAIL,
        PASSWORD,
        NAME,
        ROLE
    ) VALUES (
        #{email},
        #{password},
        #{name},
        #{role}
    )

</insert>

</mapper>